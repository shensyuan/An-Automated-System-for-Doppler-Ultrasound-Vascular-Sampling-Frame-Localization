# Build outputs / IDE caches — always regenerated by Gradle/Android Studio
.gradle/
.idea/
*.iml
.cxx/
build/
local.properties

# Gradle download.gradle 會在缺檔時自動重新下載，避免大型二進位進版控
libraries/tensorflow-lite-*.aar

# OpenCV SDK 的靜態庫（數百 MB，pipeline 只用 native/libs 的 .so 與 native/jni 標頭）
opencv/native/3rdparty/
opencv/native/staticlibs/
opencv/native/jni/*.mk
opencv/native/jni/OpenCV*.cmake
opencv/native/jni/abi-*/
opencv/java/javadoc/
opencv/etc/haarcascades/
opencv/etc/lbpcascades/
opencv/etc/*.supp

# 只保留 App 實際用到的 assets
app/src/main/assets/*
!app/src/main/assets/ESRGAN.tflite
!app/src/main/assets/data1_clip_141s_5.83s.png
!app/src/main/assets/data1_clip_560s_6.81s.png
!app/src/main/assets/data6_0.95s.png
